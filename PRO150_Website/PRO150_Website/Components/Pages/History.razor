@page "/history"
@rendermode InteractiveServer

<table>
    <thead>
        <tr>
            <th colspan="2">
                HISTORY
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Chats.allChats.Count() != 0) {
            foreach (List<string> chat in Chats.allChats)
            {
                <tr>
                    <tb>Last Message: </tb>
                    <tb>
                        @if (chat.Count != 0) { @chat[chat.Count - 1] }
                        else { @defaultMessage; }
                    </tb>
                    <tb>
                        @if(chat != Chats.activeChat) {
                        <span> </span>
                        <button type="button"
                            class="btn btn-primary"
                            @onclick="() => Chats.SetActive(chat)">
                            Set Active
                        </button>
                        } else {
                        <span> </span>
                        <button type="button"
                            class="btn btn-Danger"
                            disabled>
                            ACTIVE
                        </button>
                        }
                        <button type="button"
                            class="btn btn-dark"
                            @onclick="() => RemoveChatFromHistory(chat)">
                            Remove Chat
                        </button>
                    </tb>
                </tr>
            }
        } else
        {
            <div>You Have had 0 Conversations go to the Chat Page to Begin</div>
        }
    </tbody>
</table>

@code {
    string defaultMessage = "No Message Yet";

    private void RemoveChatFromHistory(List<string> chat)
    {
        if (chat == Chats.activeChat)
            Chats.activeChat = null;
        Chats.allChats.Remove(chat);
    }
}
